@page "/atendimento"
@attribute [Authorize(Policy = Politicas.Atender)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ChamadoServico Servico
@using Chamados.Web.Diagnostico
@inject EstadoFila Estado
@inject IJSRuntime JS
@inject ILogger<Atendimento> Logger
@inject IAuthorizationService Autorizacao

<PageTitle>Atendimento · Chamados</PageTitle>

@* Gestão de usuários: a página é interativa e o circuito vive enquanto a aba estiver aberta. Se a
   conta for desativada ou perder o papel de atendente, a revalidação (a cada minuto) troca o usuário
   do circuito por um anônimo, e este AuthorizeView esconde a fila na hora. *@
<AuthorizeView Policy="@Politicas.Atender" Context="sessao">
    <Authorized>
        <h1>Atendimento</h1>
        <p class="apoio">Fila interativa: abrir, editar, iniciar, resolver e cancelar sem recarregar a página.</p>

        <div class="barra-fila">
            <label class="crescer">
                Buscar
                @* A cada tecla: atualiza "texto" e chama CarregarAsync, que cancela a busca anterior. *@
                <input type="search" placeholder="título ou descrição"
                       @bind="texto" @bind:event="oninput" @bind:after="CarregarAsync" />
            </label>
            <button type="button" class="neutro" disabled="@carregando" @onclick="CarregarAsync">Atualizar</button>
            <button type="button" @onclick="AbrirNovo">Novo chamado</button>
        </div>

        @* Região "viva": leitores de tela anunciam o texto quando ele muda. *@
        <p class="carregando" role="status" aria-live="polite">@(carregando ? "Atualizando a fila…" : null)</p>

        @if (mensagem is not null)
        {
            <p class="@(mensagemDeErro ? "erros aviso-erro" : "aviso")" role="status">@mensagem</p>
        }

        @if (painelAberto)
        {
            <section class="painel" aria-labelledby="titulo-painel">
                <h2 id="titulo-painel">@(painelId is null ? "Novo chamado" : "Editar chamado")</h2>
                @* @key: trocar de chamado cria um formulário novo, sem restos do anterior. *@
                <FormularioChamado @key="painelId" ChamadoId="painelId" AoSalvar="AoSalvarAsync" AoFechar="FecharPainel" />
            </section>
        }

        @if (falha is not null)
        {
            <div class="erros aviso-erro" role="alert">
                <p>@falha</p>
                <button type="button" class="neutro" @onclick="CarregarAsync">Tentar de novo</button>
            </div>
        }

        @if (Chamados is null)
        {
            <p class="vazio">Carregando a fila…</p>
        }
        else
        {
            @* Rede de segurança: um erro inesperado ao desenhar a fila fica contido aqui,
               em vez de derrubar o circuito inteiro. *@
            <ErrorBoundary @ref="limiteDaFila">
                <ChildContent>
                    <div class="fila" aria-busy="@(carregando ? "true" : "false")">
                        <Coluna Titulo="Abertos" Quantidade="Abertos.Count" TextoVazio="Nenhum chamado aguardando.">
                            @foreach (var chamado in Abertos)
                            {
                                <CartaoChamado @key="chamado.Id" Chamado="chamado" Prazo="Servico.PrazoDe(chamado)"
                                               ResponsavelPadrao="@responsavelPadrao"
                                               Desabilitado="executando" AoConfirmar="ExecutarAsync" AoEditar="AbrirEdicao" />
                            }
                        </Coluna>

                        <Coluna Titulo="Em atendimento" Quantidade="EmAtendimento.Count" TextoVazio="Nenhum chamado em atendimento.">
                            @foreach (var chamado in EmAtendimento)
                            {
                                <CartaoChamado @key="chamado.Id" Chamado="chamado" Prazo="Servico.PrazoDe(chamado)"
                                               ResponsavelPadrao="@responsavelPadrao"
                                               Desabilitado="executando" AoConfirmar="ExecutarAsync" AoEditar="AbrirEdicao" />
                            }
                        </Coluna>
                    </div>
                </ChildContent>
                <ErrorContent>
                    <div class="erros aviso-erro" role="alert">
                        <p>A fila não pôde ser exibida. O erro foi registrado no log.</p>
                        <button type="button" class="neutro" @onclick="RecuperarAsync">Tentar de novo</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Atendimento</h1>
        <p class="erros aviso-erro" role="alert">
            Sua sessão terminou ou o seu acesso mudou. <a href="/Conta/Entrar?ReturnUrl=%2Fatendimento">Entre de novo</a>.
        </p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string ChaveResponsavel = "chamados.responsavel";

    private string? texto;
    private string? mensagem;
    private bool mensagemDeErro;
    private string? falha;
    private bool carregando;
    private bool executando;
    private bool painelAberto;
    private Guid? painelId;
    private string? responsavelPadrao;
    private CancellationTokenSource? cancelamento;
    private IJSObjectReference? moduloPreferencias;
    private ErrorBoundary? limiteDaFila;
    private Timer? relogioDosPrazos;

    /// <summary>Meus chamados: o usuário conectado, entregue em cascata (AddCascadingAuthenticationState).</summary>
    [CascadingParameter]
    private Task<AuthenticationState>? Autenticacao { get; set; }

    /// <summary>
    /// A fila. [PersistentState] guarda o valor carregado na pré-renderização dentro do HTML
    /// e o devolve quando o circuito começa: a lista não é buscada duas vezes.
    /// Precisa ser propriedade pública.
    /// </summary>
    [PersistentState]
    public List<ResumoChamado>? Chamados { get; set; }

    private List<ResumoChamado> Abertos
        => Chamados!.Where(c => c.Status == StatusChamado.Aberto).ToList();

    private List<ResumoChamado> EmAtendimento
        => Chamados!.Where(c => c.Status == StatusChamado.EmAtendimento).ToList();

    protected override async Task OnInitializedAsync()
    {
        Registro.AtendimentoIniciado(Logger, RendererInfo.IsInteractive, Chamados is not null);

        if (Chamados is null)
        {
            await CarregarAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JavaScript só existe no navegador: este método não roda na pré-renderização.
        if (!firstRender)
        {
            return;
        }

        // Prazos: "vence em 12 min" envelhece com a tela aberta. A cada minuto o componente se
        // redesenha; o prazo é recalculado com o relógio, sem consultar o banco de novo.
        relogioDosPrazos = new Timer(_ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));

        try
        {
            moduloPreferencias = await JS.InvokeAsync<IJSObjectReference>("import", "./js/preferencias.js");
            responsavelPadrao = await moduloPreferencias.InvokeAsync<string?>("ler", ChaveResponsavel);
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // A aba fechou durante a chamada: não há mais navegador para responder.
        }
    }

    private async Task CarregarAsync()
    {
        // Uma busca nova torna a anterior inútil: cancela antes de começar.
        cancelamento?.Cancel();
        cancelamento?.Dispose();
        var esta = cancelamento = new CancellationTokenSource();

        carregando = true;
        falha = null;
        try
        {
            Chamados = [.. await Servico.ListarAsync(new FiltroChamados(Texto: texto), esta.Token)];
        }
        catch (OperationCanceledException) when (esta.IsCancellationRequested)
        {
            // Esperado: outra busca começou (ou a página foi fechada). Nada a mostrar.
            Registro.BuscaCancelada(Logger);
        }
        catch (Exception ex)
        {
            // Mensagem amigável na tela; detalhes técnicos só no log.
            Registro.FalhaAoCarregarFila(Logger, ex);
            falha = "Não foi possível carregar a fila agora. Os dados na tela podem estar desatualizados.";
        }
        finally
        {
            // Só a busca mais recente desliga o indicador.
            if (esta == cancelamento)
            {
                carregando = false;
            }
        }
    }

    private async Task ExecutarAsync(PedidoTransicao pedido)
    {
        // Gestão de usuários: a regra vale no clique, não só ao abrir a página. Entre uma revalidação
        // e outra, um botão ainda na tela não pode agir por quem já perdeu o acesso.
        if (!await PodeAtenderAsync())
        {
            Avisar("Sua sessão terminou ou o seu acesso mudou. Entre de novo.", erro: true);
            return;
        }

        executando = true;
        try
        {
            // Meus chamados: quem clicou vai para o histórico do chamado.
            var por = Autenticacao is null ? null : (await Autenticacao).User.ComoAutor();
            var chamado = pedido.Tipo switch
            {
                TipoTransicao.Iniciar => await Servico.IniciarAtendimentoAsync(pedido.ChamadoId, pedido.Texto, por),
                TipoTransicao.Resolver => await Servico.ResolverAsync(pedido.ChamadoId, pedido.Texto, por),
                _ => await Servico.CancelarAsync(pedido.ChamadoId, pedido.Texto, por)
            };

            Avisar($"\"{chamado.Titulo}\" agora está {chamado.Status.Rotulo().ToLowerInvariant()}.", erro: false);

            if (pedido.Tipo == TipoTransicao.Iniciar)
            {
                await LembrarResponsavelAsync(pedido.Texto.Trim());
            }
        }
        catch (TransicaoInvalidaException ex)
        {
            Avisar($"O chamado já está {ex.Atual.Rotulo().ToLowerInvariant()}. A fila foi atualizada.", erro: true);
        }
        catch (ChamadoNaoEncontradoException)
        {
            Avisar("O chamado não existe mais. A fila foi atualizada.", erro: true);
        }
        catch (ConcorrenciaException)
        {
            // Módulo 7: duas abas agiram no mesmo instante; o banco aceitou só a primeira gravação.
            Avisar("Outra pessoa alterou este chamado no mesmo instante. A fila foi atualizada.", erro: true);
        }
        catch (ArgumentException ex)
        {
            Avisar(ex.ParaUsuario(), erro: true);
        }
        finally
        {
            executando = false;
        }

        await CarregarAsync();
        await Estado.AtualizarAsync();
    }

    private async Task<bool> PodeAtenderAsync()
        => Autenticacao is not null
            && (await Autorizacao.AuthorizeAsync((await Autenticacao).User, Politicas.Atender)).Succeeded;

    private async Task LembrarResponsavelAsync(string nome)
    {
        responsavelPadrao = nome;
        if (moduloPreferencias is not null)
        {
            await moduloPreferencias.InvokeVoidAsync("gravar", ChaveResponsavel, nome);
        }
    }

    private void AbrirNovo() => AbrirPainel(null);

    private void AbrirEdicao(Guid id) => AbrirPainel(id);

    private void AbrirPainel(Guid? id)
    {
        painelId = id;
        painelAberto = true;
        mensagem = null;
    }

    private void FecharPainel() => painelAberto = false;

    private async Task AoSalvarAsync(ResumoChamado salvo)
    {
        Avisar(painelId is null ? $"\"{salvo.Titulo}\" foi aberto." : $"\"{salvo.Titulo}\" foi salvo.", erro: false);
        painelAberto = false;
        await CarregarAsync();
        await Estado.AtualizarAsync();
    }

    private async Task RecuperarAsync()
    {
        limiteDaFila?.Recover();
        await CarregarAsync();
    }

    private void Avisar(string texto, bool erro)
    {
        mensagem = texto;
        mensagemDeErro = erro;
    }

    public async ValueTask DisposeAsync()
    {
        // A aba fechou ou o usuário navegou: interrompe a busca em andamento e o relógio dos prazos.
        cancelamento?.Cancel();
        cancelamento?.Dispose();
        if (relogioDosPrazos is not null)
        {
            await relogioDosPrazos.DisposeAsync();
        }

        if (moduloPreferencias is not null)
        {
            try
            {
                await moduloPreferencias.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // O circuito já caiu; o navegador libera o módulo sozinho.
            }
        }
    }
}

@using global::Chamados.Web.Seguranca
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Autorizacao
@{
    // Módulo 8: os links seguem as políticas; quem protege de fato são as páginas e a API.
    var podeAtender = (await Autorizacao.AuthorizeAsync(User, Politicas.Atender)).Succeeded;
    var podeVerIndicadores = (await Autorizacao.AuthorizeAsync(User, Politicas.VerIndicadores)).Succeeded;
    var conectado = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Chamados</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <a class="marca" asp-page="/Index">Chamados</a>
        @* View Component: tem lógica e dependências próprias, ao contrário de uma partial. *@
        @if (conectado)
        {
            <vc:resumo-status />
            <nav>
                @* Página Blazor (Módulo 5): link comum, porque não é uma Razor Page. *@
                @if (podeAtender)
                {
                    <a href="/atendimento">Atendimento</a>
                }
                @if (podeVerIndicadores)
                {
                    <a href="/indicadores">Indicadores</a>
                }
                <a asp-page="/Chamados/Index">Lista</a>
                <a class="botao" asp-page="/Chamados/Novo">Novo chamado</a>
            </nav>
            <form method="post" asp-page="/Conta/Sair" class="sessao">
                <span>@User.Identity!.Name</span>
                <button type="submit" class="link">Sair</button>
            </form>
        }
    </header>

    <main class="conteudo">
        @* Mensagem de uma única leitura: gravada antes do redirect, lida aqui e descartada. *@
        @if (TempData["Mensagem"] is string mensagem)
        {
            <p class="aviso" role="status">@mensagem</p>
        }

        @RenderBody()
    </main>

    <footer class="rodape">Chamados · Módulo 8 · Segurança, testes e qualidade</footer>

    @* Cada página pode acrescentar scripts aqui com @section Scripts { ... }. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page "{id:guid}"
@model DetalhesModel
@{
    var chamado = Model.Chamado;
    ViewData["Title"] = chamado.Titulo;
}

<p><a asp-page="./Index">← Voltar para a lista</a></p>

<h1>@chamado.Titulo</h1>
<p class="selos">
    <selo valor="@chamado.Status" />
    <selo valor="@chamado.Prioridade" prefixo="Prioridade " />
    @if (!chamado.EstaEncerrado && Model.PodeAtender)
    {
        <a class="editar" asp-page="./Editar" asp-route-id="@chamado.Id">Editar dados</a>
    }
</p>

<dl class="ficha">
    <dt>Descrição</dt>
    @* Módulo 8: @ codifica o texto em HTML. Uma descrição com <script> aparece como texto,
       não executa. Html.Raw aqui abriria a porta para XSS. *@
    <dd class="texto-livre">@(chamado.Descricao ?? "—")</dd>
    <dt>Aberto em</dt>
    <dd>@chamado.CriadoEm.DataHora()</dd>
    @* Meus chamados: quem abriu. Chamados anteriores a este recurso não têm dono. *@
    <dt>Aberto por</dt>
    <dd>@(chamado.AbertoPor?.Nome ?? "—")</dd>
    @* Prazos: vencimento = abertura + prazo da prioridade atual. Cancelado não tem prazo. *@
    @if (Model.Prazo is { } prazo)
    {
        <dt>Prazo</dt>
        <dd class="prazo"><selo valor="@prazo.Situacao" /> @prazo.Vencimento.DataHora() · @prazo.Descricao()</dd>
    }
    <dt>Responsável</dt>
    <dd>@(chamado.Responsavel ?? "—")</dd>
    @if (chamado.Solucao is not null)
    {
        <dt>Solução</dt>
        <dd>@chamado.Solucao</dd>
    }
    @if (chamado.EncerradoEm is { } encerradoEm)
    {
        <dt>Encerrado em</dt>
        <dd>@encerradoEm.DataHora()</dd>
    }
</dl>

<div asp-validation-summary="ModelOnly" class="erros"></div>

@if (!chamado.EstaEncerrado && Model.PodeAtender)
{
    <section class="transicoes">
        @if (chamado.Status == StatusChamado.Aberto)
        {
            @* Responsável atendente: escolhe-se uma pessoa da lista de atendentes; você vem marcado. *@
            <form method="post" asp-page-handler="Iniciar" asp-route-id="@chamado.Id" class="cartao-acao">
                <h2>Iniciar atendimento</h2>
                <label for="responsavel">Quem vai atender</label>
                <select id="responsavel" name="responsavelId">
                    @foreach (var atendente in Model.OpcoesDeResponsavel)
                    {
                        <option value="@atendente.Id" selected="@(atendente.Id == Model.UsuarioId)">@(atendente.Id == Model.UsuarioId ? $"{atendente.Nome} (você)" : atendente.Nome)</option>
                    }
                </select>
                @Html.ValidationMessage("responsavelId", new { @class = "erro" })
                <button type="submit">Iniciar</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Resolver" asp-route-id="@chamado.Id" class="cartao-acao">
                <h2>Resolver</h2>
                <label for="solucao">Solução aplicada</label>
                <input id="solucao" name="solucao" autocomplete="off" maxlength="@Chamado.TamanhoMaximoJustificativa" />
                @Html.ValidationMessage("solucao", new { @class = "erro" })
                <button type="submit">Resolver</button>
            </form>

            <form method="post" asp-page-handler="Reatribuir" asp-route-id="@chamado.Id" class="cartao-acao">
                <h2>Passar para outra pessoa</h2>
                <label for="novo-responsavel">Novo responsável</label>
                <select id="novo-responsavel" name="responsavelId">
                    @foreach (var atendente in Model.OpcoesDeResponsavel)
                    {
                        <option value="@atendente.Id" selected="@chamado.FoiAtribuidoA(atendente.Id)">@(atendente.Id == Model.UsuarioId ? $"{atendente.Nome} (você)" : atendente.Nome)</option>
                    }
                </select>
                @Html.ValidationMessage("responsavelId", new { @class = "erro" })
                <button type="submit" class="neutro">Reatribuir</button>
            </form>
        }

        <form method="post" asp-page-handler="Cancelar" asp-route-id="@chamado.Id" class="cartao-acao">
            <h2>Cancelar</h2>
            <label for="motivo">Motivo</label>
            <input id="motivo" name="motivo" autocomplete="off" maxlength="@Chamado.TamanhoMaximoJustificativa" />
            @Html.ValidationMessage("motivo", new { @class = "erro" })
            <button type="submit" class="secundario">Cancelar chamado</button>
        </form>
    </section>
}

<h2>Histórico</h2>
@* Histórico das edições: mudanças de status e edições numa linha do tempo só, da mais antiga para a mais nova. *@
@if (Model.LinhaDoTempo.Count == 0)
{
    <p class="vazio">Nenhuma mudança ainda.</p>
}
else
{
    <ol class="historico">
        @foreach (var item in Model.LinhaDoTempo)
        {
            <li>
                @switch (item)
                {
                    case RegistroHistorico registro:
                        <time>@registro.Em.DataHora()</time>
                        @:@registro.De.Rotulo() → <strong>@registro.Para.Rotulo()</strong>
                        @if (registro.Observacao is not null)
                        {
                            <span class="apoio">· @registro.Observacao</span>
                        }
                        @* Meus chamados: quem fez a mudança (registros antigos não têm). *@
                        @if (registro.Por is { } por)
                        {
                            <span class="apoio">· por @por.Nome</span>
                        }
                        break;

                    case RegistroEdicao edicao when edicao.ResponsavelNovo is not null:
                        @* Responsável atendente: a troca de responsável também é uma edição. *@
                        <time>@edicao.Em.DataHora()</time>
                        <strong>Responsável alterado</strong>
                        <span class="apoio">· @(edicao.ResponsavelAnterior ?? "—") → @edicao.ResponsavelNovo</span>
                        @if (edicao.Por is { } quem)
                        {
                            <span class="apoio">· por @quem.Nome</span>
                        }
                        break;

                    case RegistroEdicao edicao:
                        <time>@edicao.Em.DataHora()</time>
                        <strong>Dados editados</strong>
                        @* Mudar a prioridade muda o prazo: por isso ela aparece primeiro. *@
                        @if (edicao.PrioridadeAnterior is { } antes && edicao.PrioridadeNova is { } depois)
                        {
                            <span class="apoio">· prioridade @antes.Rotulo() → @depois.Rotulo()</span>
                        }
                        @if (edicao.TituloNovo is not null)
                        {
                            <span class="apoio">· título “@edicao.TituloAnterior” → “@edicao.TituloNovo”</span>
                        }
                        @if (edicao.DescricaoAlterada)
                        {
                            <span class="apoio">· descrição alterada</span>
                        }
                        @if (edicao.Por is { } autor)
                        {
                            <span class="apoio">· por @autor.Nome</span>
                        }
                        break;
                }
            </li>
        }
    </ol>
}

@* Comentários: a conversa entre quem pediu e quem atende. Cada mensagem mostra autor, data e hora;
   as do usuário conectado ficam à direita. O texto passa pela codificação do @, como a descrição. *@
<section id="conversa" class="conversa" aria-labelledby="titulo-conversa">
    <h2 id="titulo-conversa">Conversa</h2>
    @if (chamado.Comentarios.Count == 0)
    {
        <p class="vazio">Nenhuma mensagem ainda.</p>
    }
    else
    {
        <ol class="mensagens">
            @foreach (var mensagem in chamado.Comentarios)
            {
                var minha = mensagem.AutorId == Model.UsuarioId;
                <li class="mensagem@(minha ? " minha" : "")">
                    <p class="mensagem-cabecalho">
                        <strong>@(minha ? "Você" : mensagem.AutorNome)</strong>
                        @if (chamado.FoiAbertoPor(mensagem.AutorId))
                        {
                            <span class="papel">solicitante</span>
                        }
                        <time datetime="@mensagem.Em.Iso()">@mensagem.Em.DataHoraMensagem()</time>
                    </p>
                    <p class="texto-livre">@mensagem.Texto</p>
                </li>
            }
        </ol>
    }

    <form method="post" asp-page-handler="Comentar" asp-route-id="@chamado.Id" class="nova-mensagem">
        <label for="texto">Nova mensagem</label>
        <textarea id="texto" name="texto" rows="3" maxlength="@Chamado.TamanhoMaximoComentario">@Model.TextoDigitado</textarea>
        @Html.ValidationMessage("texto", new { @class = "erro" })
        <button type="submit">Enviar</button>
    </form>
</section>

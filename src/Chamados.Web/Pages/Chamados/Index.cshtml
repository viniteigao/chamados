@page
@model IndexModel
@{
    // Meus chamados: o título diz de quem é a lista. Mensagens não lidas: e se ela traz só as com mensagens novas.
    ViewData["Title"] = Model.ComNaoLidas ? "Mensagens novas"
        : Model.AtribuidosAMim ? "Meus atendimentos" : Model.SoOsMeus ? "Meus chamados" : "Chamados";
    var pagina = Model.Resultado;
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="filtros">
    <label>
        Status
        <select asp-for="Status" asp-items="Rotulos.OpcoesStatus()">
            <option value="">Todos</option>
        </select>
    </label>
    <label>
        Prioridade mínima
        <select asp-for="PrioridadeMinima" asp-items="Rotulos.OpcoesPrioridade()">
            <option value="">Qualquer</option>
        </select>
    </label>
    <label>
        Ordenar por
        <select asp-for="Ordem" asp-items="Rotulos.OpcoesOrdem()"></select>
    </label>
    <label class="crescer">
        Texto
        <input asp-for="Texto" type="search" placeholder="título ou descrição" />
    </label>
    @* Prazos: checkbox comum, e não asp-for, que acrescentaria um campo oculto "false" à URL.
       checked="@bool" do Razor: com false, o atributo nem é escrito. *@
    <label class="marcar">
        <input type="checkbox" name="somenteVencidos" value="true" checked="@Model.SomenteVencidos" />
        Só vencidos
    </label>
    @* Meus chamados: a escolha só existe para quem vê todos; os demais já veem só os seus. *@
    @if (Model.PodeEscolher)
    {
        <label class="marcar">
            <input type="checkbox" name="meus" value="true" checked="@Model.Meus" />
            Só os meus
        </label>
    }
    @* Responsável atendente: os chamados que estão com você. *@
    @if (Model.PodeFiltrarAtribuidos)
    {
        <label class="marcar">
            <input type="checkbox" name="atribuidosAMim" value="true" checked="@Model.AtribuidosAMim" />
            Atribuídos a mim
        </label>
    }
    @* Mensagens não lidas: os chamados com mensagem que você ainda não leu. *@
    <label class="marcar">
        <input type="checkbox" name="comNaoLidas" value="true" checked="@Model.ComNaoLidas" />
        Com mensagens novas
    </label>
    @* Sem campo "pagina": filtrar de novo sempre volta para a página 1. *@
    <button type="submit">Filtrar</button>
    <a asp-page="./Index">Limpar</a>
</form>

@if (pagina.TotalItens == 0)
{
    <p class="vazio">
        @(Model.ComNaoLidas ? "Nenhuma mensagem nova para você com esses filtros."
            : Model.SoOsMeus ? "Nenhum chamado seu com esses filtros." : "Nenhum chamado encontrado com esses filtros.")
        <a asp-page="./Novo">Abrir um chamado</a>
    </p>
}
else
{
    <p class="apoio">
        @pagina.TotalItens @(pagina.TotalItens == 1 ? "chamado" : "chamados") ·
        página @pagina.Numero de @pagina.TotalPaginas
    </p>

    <table class="tabela">
        <thead>
            <tr><th>Título</th><th>Prioridade</th><th>Status</th><th>Prazo</th><th>Responsável</th><th>Aberto em</th></tr>
        </thead>
        <tbody>
            @foreach (var chamado in pagina.Itens)
            {
                var prazo = Model.PrazoDe(chamado);
                <tr>
                    <td>
                        <a asp-page="./Detalhes" asp-route-id="@chamado.Id">@chamado.Titulo</a>
                        @* Comentários: quantas mensagens a conversa tem, com link direto para ela. *@
                        @if (chamado.TotalComentarios > 0)
                        {
                            <a class="contador-mensagens" asp-page="./Detalhes" asp-route-id="@chamado.Id" asp-fragment="conversa">@chamado.TotalComentarios.Mensagens()</a>
                        }
                        @* Mensagens não lidas: o selo leva direto à primeira mensagem nova. *@
                        @if (chamado.ComentariosNaoLidos is int novas and > 0)
                        {
                            <a class="selo-novas" asp-page="./Detalhes" asp-route-id="@chamado.Id" asp-fragment="novas"
                               title="@novas.MensagensNovas() para você">@novas.Novas()</a>
                        }
                    </td>
                    <td><selo valor="@chamado.Prioridade" /></td>
                    <td><selo valor="@chamado.Status" /></td>
                    @* Prazos: o selo e, ao passar o mouse, a frase e o vencimento. Cancelado: sem prazo. *@
                    <td>
                        @if (prazo is not null)
                        {
                            <span title="@prazo.Descricao() (vencimento @prazo.Vencimento.DataHora())"><selo valor="@prazo.Situacao" /></span>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>@(chamado.Responsavel ?? "—")</td>
                    <td>@chamado.CriadoEm.DataHora()</td>
                </tr>
            }
        </tbody>
    </table>

    @if (pagina.TotalPaginas > 1)
    {
        <nav class="paginacao" aria-label="Páginas da lista">
            @if (pagina.TemAnterior)
            {
                <a href="@Url.Page("./Index", Model.RotaPara(pagina.Numero - 1))" rel="prev">← Anterior</a>
            }
            @for (var n = 1; n <= pagina.TotalPaginas; n++)
            {
                if (n == pagina.Numero)
                {
                    <span class="atual" aria-current="page">@n</span>
                }
                else
                {
                    <a href="@Url.Page("./Index", Model.RotaPara(n))">@n</a>
                }
            }
            @if (pagina.TemProxima)
            {
                <a href="@Url.Page("./Index", Model.RotaPara(pagina.Numero + 1))" rel="next">Próxima →</a>
            }
        </nav>
    }
}

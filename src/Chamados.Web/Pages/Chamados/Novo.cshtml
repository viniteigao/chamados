@page
@model NovoModel
@{
    ViewData["Title"] = "Novo chamado";
}

<h1>Novo chamado</h1>

<form method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="erros"></div>

    <partial name="_CamposChamado" for="Input" />

    <div class="acoes">
        <button type="submit">Abrir chamado</button>
        <a asp-page="./Index">Cancelar</a>
    </div>
</form>

@* Validação no cliente: conforto para o usuário. O servidor valida de novo no OnPostAsync. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
